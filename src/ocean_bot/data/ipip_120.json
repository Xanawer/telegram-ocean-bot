{
  "id": "ipip-120",
  "version": "1.0.0",
  "title": "IPIP-NEO-120 Big Five",
  "estimated_minutes": [
    18,
    25
  ],
  "source_urls": [
    "https://ipip.ori.org/newTheIPIP-NEO-120-itemInventory.htm",
