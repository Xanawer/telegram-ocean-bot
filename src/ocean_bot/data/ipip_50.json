{
  "id": "ipip-50",
  "version": "1.0.0",
  "title": "Detailed Big Five",
  "estimated_minutes": [
    8,
    12
  ],
  "source_urls": [
    "https://ipip.ori.org/new_ipip-50-item-scale.htm",
