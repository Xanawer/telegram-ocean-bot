OCEAN_BOT_TOKEN=replace-with-botfather-token
OCEAN_DATABASE_URL=postgresql://ocean:change-me@localhost:5432/ocean
OCEAN_ANALYTICS_PEPPER=replace-with-at-least-16-random-characters
OCEAN_ADMIN_USER_ID=123456789
OCEAN_PRIVACY_CONTACT=privacy@example.com
# Leave unset for local long polling.
# OCEAN_WEBHOOK_BASE_URL=https://bot.example.com
# OCEAN_WEBHOOK_SECRET=replace-with-a-random-telegram-webhook-secret
OCEAN_PORT=8080
# Use external for serverless deployments with a daily scheduled retention job.
OCEAN_RETENTION_MODE=background
# Use external when `python -m ocean_bot set-webhook` is a release step.
OCEAN_WEBHOOK_SETUP_MODE=startup
# Local-first rollout: remote (disabled), shadow, then authoritative.
OCEAN_STORAGE_MODE=remote
# Mount a persistent Railway Volume at /data before enabling shadow mode.
# OCEAN_LOCAL_DATABASE_URL=sqlite+aiosqlite:////data/ocean-local.db
